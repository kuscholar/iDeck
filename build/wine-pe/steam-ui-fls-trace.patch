+                steam_ui_fls_event( "free-index-begin", index, fls->fls_data_chunks[chunk_index][idx + 1], callback, fls );
                 callback( fls->fls_data_chunks[chunk_index][idx + 1] );
+                steam_ui_fls_event( "free-index-end", index, fls->fls_data_chunks[chunk_index][idx + 1], callback, fls );
             }
             fls->fls_data_chunks[chunk_index][idx + 1] = NULL;
         }
@@ -668,6 +756,7 @@ NTSTATUS WINAPI DECLSPEC_HOTPATCH RtlFlsSetValue( ULONG index, void *data )
             (fls_chunk_size( chunk_index ) + 1) * sizeof(*fls->fls_data_chunks[chunk_index]) )))
         return STATUS_NO_MEMORY;
 
+    steam_ui_fls_event( "set", index, data, NULL, fls );
     fls->fls_data_chunks[chunk_index][idx + 1] = data;
 
     return STATUS_SUCCESS;
@@ -737,7 +826,9 @@ void WINAPI DECLSPEC_HOTPATCH RtlProcessFlsData( void *teb_fls_data, ULONG flags
                     TRACE_(relay)("Calling FLS callback %p, arg %p.\n", callback,
                             fls->fls_data_chunks[i][index + 1]);
 
+                    steam_ui_fls_event( "thread-exit-begin", fls_index_from_chunk_index(i, index), fls->fls_data_chunks[i][index + 1], callback, fls );
                     callback( fls->fls_data_chunks[i][index + 1] );
+                    steam_ui_fls_event( "thread-exit-end", fls_index_from_chunk_index(i, index), fls->fls_data_chunks[i][index + 1], callback, fls );
                 }
                 fls->fls_data_chunks[i][index + 1] = NULL;
             }
