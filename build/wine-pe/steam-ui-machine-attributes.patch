From: iDeck compatibility work
Subject: Backport GetMachineTypeAttributes for the pinned Wine runtime

Based on Brendan Shanks <bshanks@codeweavers.com>, Wine MR10558,
https://list.winehq.org/hyperkitty/list/wine-gitlab@list.winehq.org/thread/ZQBFNVIXTGEJCOETMJKKS3AGOCV3B5UT/
Original contribution and this adaptation: LGPL-2.1-or-later.
Adaptation uses class 181 and normalizes AMD64-on-ARM64 namespace attributes.
The companion isolated server change advertises existing AMD64 execution.

--- a/dlls/kernel32/kernel32.spec
+++ b/dlls/kernel32/kernel32.spec
@@ -732,6 +732,7 @@
 # @ stub GetLongPathNameTransactedA
 # @ stub GetLongPathNameTransactedW
 @ stdcall -import GetLongPathNameW(wstr ptr long)
+@ stdcall -import GetMachineTypeAttributes(long ptr)
 @ stdcall GetMailslotInfo(long ptr ptr ptr ptr)
 @ stdcall GetMaximumProcessorCount(long)
 @ stdcall GetMaximumProcessorGroupCount()
--- a/dlls/kernelbase/kernelbase.spec
+++ b/dlls/kernelbase/kernelbase.spec
@@ -587,6 +587,7 @@
 @ stdcall GetLogicalProcessorInformationEx(long ptr ptr)
 @ stdcall GetLongPathNameA(str ptr long)
 @ stdcall GetLongPathNameW(wstr ptr long)
+@ stdcall GetMachineTypeAttributes(long ptr)
 @ stdcall GetMappedFileNameA(long ptr ptr long)
 @ stdcall GetMappedFileNameW(long ptr ptr long)
 # @ stub GetMemoryErrorHandlingCapabilities
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -827,6 +827,35 @@
 
 
 /***********************************************************************
+ * GetMachineTypeAttributes (kernelbase.@)
+ * Backported/adapted from Brendan Shanks, Wine MR10558 (2026-04-03), LGPL.
+ * This pinned Wine has the legacy class 181, not class 230. AMD64 on ARM64
+ * uses the root namespace, so it must not claim a WoW64 container.
+ */
+HRESULT WINAPI GetMachineTypeAttributes( USHORT machine, MACHINE_ATTRIBUTES *attr )
+{
+    SYSTEM_SUPPORTED_PROCESSOR_ARCHITECTURES_INFORMATION machines[8];
+    HANDLE process = NULL;
+    NTSTATUS status;
+    unsigned int i;
+
+    status = NtQuerySystemInformationEx( SystemSupportedProcessorArchitectures, &process, sizeof(process),
+                                        machines, sizeof(machines), NULL );
+    if (status) return HRESULT_FROM_NT(status);
+    *attr = 0;
+    for (i = 0; machines[i].Machine; i++)
+    {
+        if (machines[i].Machine != machine) continue;
+        if (machines[i].KernelMode) *attr |= KernelEnabled;
+        if (machines[i].UserMode) *attr |= UserEnabled;
+        if (machines[i].WoW64Container &&
+            !(machine == IMAGE_FILE_MACHINE_AMD64 && machines[0].Machine == IMAGE_FILE_MACHINE_ARM64))
+            *attr |= Wow64Container;
+    }
+    return S_OK;
+}
+
